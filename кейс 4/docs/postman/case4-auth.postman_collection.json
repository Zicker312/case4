{
  "info": {
    "name": "Maintenance API — Case 4 Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost"},
    {"key": "token", "value": ""}
  ],
  "item": [
    {"name": "Health live", "request": {"method": "GET", "url": "{{baseUrl}}/api/health/live"}},
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"email\":\"admin@example.com\",\"password\":\"Admin123!\"}"},
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('login 200',()=>pm.response.to.have.status(200));", "pm.collectionVariables.set('token',pm.response.json().data.accessToken);"]}}]
    },
    {"name": "Me", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/auth/me"}},
    {"name": "Protected without token", "request": {"method": "GET", "url": "{{baseUrl}}/api/requests"}},
    {"name": "Swagger", "request": {"method": "GET", "url": "{{baseUrl}}/api/docs/"}},
    {"name": "Metrics", "request": {"method": "GET", "url": "{{baseUrl}}/metrics"}}
  ]
}
